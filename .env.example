# Destination Diaries — environment variables
# Copy to .env.local (Next.js) AND .env (Prisma CLI). Never commit real values.
# Full explanations: docs/ENVIRONMENT_SETUP.md

# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (required) ──
# Pooled connection used by the app (transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection used by `prisma migrate` (port 5432)
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mapbox ──
# Public token (pk.*) — intended to be public; restrict by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional secret token for server-side Directions. Unset = labelled heuristic routing.
MAPBOX_SECRET_TOKEN=

# ── AI (optional) ──
# Unset = deterministic fallbacks; the planner still works.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ── Admin bootstrap (optional) ──
# Comma-separated emails promoted to ADMIN when their profile is created.
ADMIN_EMAILS=
